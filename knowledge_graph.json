    "style_constraints": {

        "high_shoulder_tilt": {
            "allows": ["shoulder_angle_release_deg"],
            "requires": {
            "elbow_angle_release_deg": { "min": 105.0 },
            "elbow_rom_deg": { "min": 35.0 }
            },
            "notes": "When torso is tilted, elbow extension must compensate to maintain vertical force direction."
        },

        "tilted": {
            "allows": ["shoulder_angle_release_deg"],
            "requires": {
            "elbow_angle_release_deg": { "min": 100.0 }
            },
            "notes": "Mild torso tilt is acceptable if elbow extension is sufficient."
        },

        "compact": {
            "allows": ["dip_duration_s"],
            "requires": {
            "elbow_rom_deg": { "min": 40.0 },
            "elbow_smoothness": { "min": 2500.0 }
            },
            "notes": "Compact shooters rely on smooth elbow ROM rather than large leg motion."
        },

        "one_motion": {
            "allows": ["dip_duration_s", "drive_duration_s"],
            "requires": {
            "knee_elbow_delay_ms": { "max": 200 },
            "drive_duration_s": { "min": 0.6 }
            },
            "notes": "One-motion shots require continuous kinetic chaining from legs to arm."
        },

        "two_motion": {
            "allows": ["knee_elbow_delay_ms"],
            "requires": {
            "knee_elbow_delay_ms": { "min": 0 },
            "dip_duration_s": { "min": 0.45 }
            },
            "notes": "Two-motion shooters pause slightly between leg drive and arm release."
        },

        "high_apex": {
            "allows": ["knee_angle_release_deg"],
            "requires": {
            "drive_duration_s": { "min": 0.8 },
            "knee_rom_deg": { "min": 120.0 }
            },
            "notes": "High-apex shots require sufficient vertical impulse and leg ROM."
        },

        "smooth": {
            "requires": {
            "elbow_smoothness": { "min": 3000.0 },
            "knee_smoothness": { "min": 3000.0 }
            },
            "notes": "Smooth shooters depend on temporal consistency rather than explosive motion."
        },

        "power_leg_driven": {
            "requires": {
            "knee_rom_deg": { "min": 45.0 },
            "knee_smoothness": { "min": 2000.0 },
            "drive_duration_s": { "min": 0.6 }
            },
            "notes": "Power-leg shooters generate force primarily from lower-body extension."
        },

        "quick_release": {
            "allows": ["dip_duration_s"],
            "requires": {
            "dip_duration_s": { "max": 0.4 },
            "knee_elbow_delay_ms": { "max": 150 }
            },
            "notes": "Quick releases minimize dip and leg-to-arm delay."
        },

        "high_release": {
            "allows": ["shoulder_angle_release_deg"],
            "requires": {
            "elbow_angle_release_deg": { "min": 130.0 }
            },
            "notes": "High release points require greater elbow extension at release."
        },

        "rhythm_based": {
            "requires": {
            "dip_duration_s": { "min": 0.4 },
            "drive_duration_s": { "min": 0.7 }
            },
            "notes": "Rhythm shooters rely on consistent temporal pacing."
        }
    }

