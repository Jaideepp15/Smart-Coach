    "style_constraints": {
        "tilted": {
            "_merged_from": [
                "tilted",
                "high_shoulder_tilt"
            ],
            "allows": [
                "shoulder_angle_release_deg"
            ],
            "requires": {
                "elbow_angle_release_deg": {
                    "min": 105.0
                },
                "elbow_rom_deg": {
                    "min": 35.0,
                    "max": 160.0
                }
            },
            "deviation_labels": {
                "elbow_angle_release_deg_below_min": "under_extended_elbow",
                "elbow_rom_deg_below_min": "insufficient_elbow_arc_for_tilt",
                "elbow_rom_deg_above_max": "excessive_elbow_dip"
            },
            "notes": "Torso tilt (mild or pronounced) is acceptable only when elbow extension sufficiently compensates to maintain vertical force direction. Merged from former high_shoulder_tilt (strict) and tilted (mild) \u2014 the stricter elbow_angle min of 105 deg is retained as the unified threshold. elbow_rom_deg max guards against excessive arm dip under tilt."
        },
        "compact": {
            "allows": [
                "dip_duration_s"
            ],
            "requires": {
                "elbow_rom_deg": {
                    "min": 40.0,
                    "max": 160.0
                },
                "elbow_smoothness": {
                    "min": 2500.0
                }
            },
            "deviation_labels": {
                "elbow_rom_deg_below_min": "insufficient_elbow_arc",
                "elbow_rom_deg_above_max": "excessive_elbow_dip",
                "elbow_smoothness_below_min": "jerky_elbow_motion"
            },
            "notes": "Compact shooters rely on smooth, controlled elbow ROM rather than large leg motion. Max elbow_rom_deg guards against the arm dipping excessively before the pocket."
        },
        "one_motion": {
            "allows": [
                "dip_duration_s",
                "drive_duration_s"
            ],
            "requires": {
                "knee_elbow_delay_ms": {
                    "min": -150,
                    "max": 200
                },
                "drive_duration_s": {
                    "min": 0.6
                },
                "dip_duration_s": {
                    "max": 0.55
                },
                "knee_rom_deg": {
                    "min": 30.0
                },
                "elbow_rom_deg": {
                    "max": 160.0
                }
            },
            "deviation_labels": {
                "knee_elbow_delay_ms_below_min": "early_arm_release",
                "knee_elbow_delay_ms_above_max": "late_arm_release",
                "dip_duration_s_above_max": "excessive_dip_time",
                "knee_rom_deg_below_min": "insufficient_knee_rom",
                "elbow_rom_deg_above_max": "excessive_elbow_dip"
            },
            "notes": "One-motion shots require continuous kinetic chaining from legs to arm with no pause. dip_duration_s max prevents an inadvertent two-motion pattern. knee_elbow_delay_ms min of -150 ms catches early arm release (arm fires well before legs complete). knee_rom_deg min ensures legs contribute meaningfully even in fluid shots."
        },
        "two_motion": {
            "allows": [
                "knee_elbow_delay_ms"
            ],
            "requires": {
                "knee_elbow_delay_ms": {
                    "min": 0,
                    "max": 300
                },
                "dip_duration_s": {
                    "min": 0.45,
                    "max": 0.8
                },
                "elbow_angle_release_deg": {
                    "min": 100.0
                },
                "elbow_rom_deg": {
                    "max": 160.0
                }
            },
            "deviation_labels": {
                "knee_elbow_delay_ms_below_min": "early_arm_release",
                "knee_elbow_delay_ms_above_max": "late_arm_release",
                "dip_duration_s_below_min": "insufficient_dip_for_two_motion",
                "dip_duration_s_above_max": "excessive_dip_time",
                "elbow_angle_release_deg_below_min": "low_release_point",
                "elbow_rom_deg_above_max": "excessive_elbow_dip"
            },
            "notes": "Two-motion shooters intentionally pause between leg drive and arm release; the delay window (0\u2013300 ms) defines that pause. dip_duration_s max of 0.80 s flags an excessively prolonged load phase. elbow_angle_release_deg min catches low release points. elbow_rom_deg max catches excessive arm dip in the set position."
        },
        "high_apex": {
            "allows": [
                "knee_angle_release_deg"
            ],
            "requires": {
                "drive_duration_s": {
                    "min": 0.8
                },
                "knee_rom_deg": {
                    "min": 120.0
                },
                "dip_duration_s": {
                    "max": 0.7
                },
                "knee_elbow_delay_ms": {
                    "min": 0,
                    "max": 250
                },
                "elbow_angle_release_deg": {
                    "min": 100.0
                }
            },
            "deviation_labels": {
                "drive_duration_s_below_min": "insufficient_drive_for_high_apex",
                "knee_rom_deg_below_min": "insufficient_knee_rom",
                "dip_duration_s_above_max": "excessive_dip_time",
                "knee_elbow_delay_ms_below_min": "early_arm_release",
                "knee_elbow_delay_ms_above_max": "late_arm_release",
                "elbow_angle_release_deg_below_min": "under_extended_elbow"
            },
            "notes": "High-apex shots require sufficient vertical impulse and full leg ROM. dip_duration_s max prevents the load phase from killing upward momentum. knee_elbow_delay_ms bounds catch both early and late arm release relative to the leg drive. elbow_angle_release_deg min catches the under-extended elbow deviation common in this style."
        },
        "smooth": {
            "requires": {
                "elbow_smoothness": {
                    "min": 3000.0
                },
                "knee_smoothness": {
                    "min": 3000.0
                },
                "knee_rom_deg": {
                    "min": 30.0
                },
                "dip_duration_s": {
                    "max": 0.7
                }
            },
            "deviation_labels": {
                "elbow_smoothness_below_min": "jerky_elbow_motion",
                "knee_smoothness_below_min": "jerky_knee_motion",
                "knee_rom_deg_below_min": "insufficient_knee_rom",
                "dip_duration_s_above_max": "excessive_dip_time"
            },
            "notes": "Smooth shooters depend on temporal consistency rather than explosive motion. knee_rom_deg min ensures the legs still contribute a baseline extension even in fluid shots \u2014 pure arm shooting without leg engagement is a deviation. dip_duration_s max flags disruptions in the smooth rhythm caused by an overly prolonged load."
